# Server-only secrets. Configure them in Vercel; never expose them through VITE_* variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random secret used to verify that webhook requests came from Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Optional: Telegram forum topic ID for lead messages.
TELEGRAM_THREAD_ID=
# Comma-separated production origins. Leave empty only for local development.
ALLOWED_ORIGINS=https://universesamcenter.uz,https://www.universesamcenter.uz

# OpenAI Responses API. Server-only: never use a VITE_ prefix and never commit the real key.
OPENAI_API_KEY=
# Cost-efficient default for short bot answers; can be changed without editing code.
OPENAI_MODEL=gpt-5.6-luna

# Optional public JSON endpoint backed by Google Sheets. When empty, safe built-in course data is used.
BOT_CONTENT_URL=
